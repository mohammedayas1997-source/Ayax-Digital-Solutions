import React, { useState } from "react";
import { db } from "../firebaseConfig";
import { doc, setDoc, serverTimestamp } from "firebase/firestore";
import { Send, Video, FileText, Trash2, Save } from "lucide-react";

const AdminContentManager = () => {
  const [courseId, setCourseId] = useState("software_eng");
  const [weekNum, setWeekNum] = useState(1);
  const [content, setContent] = useState({
    title: "",
    videoUrl: "",
    pdfUrl: "",
    assignment: "",
    isLocked: false,
  });

  const handleCommit = async () => {
    if (!content.title || !content.videoUrl) {
      alert("Please enter at least a Title and Video URL");
      return;
    }

    try {
      // This saves the data to courses/[COURSE_ID]/weeks/week_[NUM]
      const docRef = doc(db, "courses", courseId, "weeks", `week_${weekNum}`);
      await setDoc(docRef, {
        ...content,
        updatedAt: serverTimestamp(),
      });
      alert(`SUCCESS: Week ${weekNum} committed to ${courseId}`);
    } catch (error) {
      console.error("Error committing data:", error);
      alert("Failed to save content.");
    }
  };

  const handleDelete = async () => {
    if (
      window.confirm("Are you sure you want to delete this week's content?")
    ) {
      // Logic to delete or clear the document
      const docRef = doc(db, "courses", courseId, "weeks", `week_${weekNum}`);
      await setDoc(docRef, {});
      alert("Content Cleared.");
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-white p-10 font-sans">
      <div className="max-w-3xl mx-auto bg-slate-900 p-10 rounded-[3rem] border border-slate-800 shadow-2xl">
        <h2 className="text-3xl font-black italic uppercase mb-8 text-blue-500">
          Curriculum Committer
        </h2>

        <div className="grid grid-cols-2 gap-6 mb-8">
          <div>
            <label className="text-[10px] font-black uppercase text-gray-500 block mb-2">
              Select Course
            </label>
            <select
              value={courseId}
              onChange={(e) => setCourseId(e.target.value)}
              className="w-full bg-slate-800 border-none rounded-xl p-4 font-bold text-sm outline-none focus:ring-2 ring-blue-600"
            >
              <option value="software_eng">Software Engineering</option>
              <option value="cyber_security">Cyber Security</option>
              <option value="web_dev">Web Development</option>
            </select>
          </div>
          <div>
            <label className="text-[10px] font-black uppercase text-gray-500 block mb-2">
              Target Week
            </label>
            <input
              type="number"
              value={weekNum}
              onChange={(e) => setWeekNum(e.target.value)}
              className="w-full bg-slate-800 border-none rounded-xl p-4 font-bold text-sm outline-none focus:ring-2 ring-blue-600"
            />
          </div>
        </div>

        <div className="space-y-4">
          <input
            placeholder="MODULE TITLE (e.g. Intro to React)"
            className="w-full bg-slate-800 p-4 rounded-xl font-bold outline-none border-2 border-transparent focus:border-blue-600"
            onChange={(e) => setContent({ ...content, title: e.target.value })}
          />
          <input
            placeholder="YOUTUBE VIDEO URL"
            className="w-full bg-slate-800 p-4 rounded-xl font-bold outline-none border-2 border-transparent focus:border-blue-600"
            onChange={(e) =>
              setContent({ ...content, videoUrl: e.target.value })
            }
          />
          <input
            placeholder="PDF CLOUD LINK (Google Drive/Dropbox)"
            className="w-full bg-slate-800 p-4 rounded-xl font-bold outline-none border-2 border-transparent focus:border-blue-600"
            onChange={(e) => setContent({ ...content, pdfUrl: e.target.value })}
          />
          <textarea
            placeholder="ASSIGNMENT DETAILS"
            className="w-full bg-slate-800 p-4 rounded-xl font-bold outline-none h-32 border-2 border-transparent focus:border-blue-600"
            onChange={(e) =>
              setContent({ ...content, assignment: e.target.value })
            }
          />
        </div>

        <div className="flex gap-4 mt-10">
          <button
            onClick={handleCommit}
            className="flex-1 bg-blue-600 py-5 rounded-2xl font-black uppercase text-xs tracking-widest flex items-center justify-center gap-3 hover:bg-blue-700 transition-all"
          >
            <Save size={18} /> Commit to Database
          </button>
          <button
            onClick={handleDelete}
            className="px-8 bg-red-600/10 text-red-500 py-5 rounded-2xl font-black uppercase text-xs hover:bg-red-600 hover:text-white transition-all"
          >
            <Trash2 size={18} />
          </button>
        </div>
      </div>
    </div>
  );
};

export default AdminContentManager;
